# ============================================
# FarmVolume Configuration
# ============================================

# Solana Configuration
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_PRIVATE_KEY=your_base58_private_key_here

# Titan Exchange (get from developer.titan.exchange)
TITAN_API_ENDPOINT=wss://router-api.titan.exchange/ws
TITAN_AUTH_TOKEN=your_titan_auth_token_here

# Jupiter API
JUPITER_API_URL=https://quote-api.jup.ag/v6

# Dashboard
DASHBOARD_PORT=3847
DASHBOARD_ENABLED=true

# Volume Engine Defaults
DEFAULT_EXCHANGE=titan
DEFAULT_SLIPPAGE_BPS=50
MAX_LOSS_PERCENT=2.0
TRADE_SIZE_MIN_USD=5
TRADE_SIZE_MAX_USD=100

# Human Behavior (all in seconds)
MIN_DELAY_BETWEEN_TRADES=8
MAX_DELAY_BETWEEN_TRADES=45
SESSION_ACTIVE_MINUTES_MIN=5
SESSION_ACTIVE_MINUTES_MAX=20
SESSION_BREAK_MINUTES_MIN=2
SESSION_BREAK_MINUTES_MAX=15
PAIR_SWITCH_AFTER_TRADES_MIN=4
PAIR_SWITCH_AFTER_TRADES_MAX=12
DISTRACTION_TRADES_MIN=1
DISTRACTION_TRADES_MAX=3
